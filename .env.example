# Copy this file to .env and fill in your key from https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Model: claude-sonnet-5-5 (default), claude-haiku-5-5 (cheapest), claude-opus-5-5 (strongest)
ASK_HARSHA_MODEL=claude-sonnet-5-5

# ---- Web server only ----
# Stop answering for the day after this much estimated spend, in US dollars
DAILY_BUDGET_USD=2
# Prices per million tokens; match them to the model above
PRICE_IN_PER_MTOK=2
PRICE_OUT_PER_MTOK=10
# Questions allowed per visitor in each window (seconds)
RATE_LIMIT_PER_WINDOW=12
RATE_WINDOW_SECONDS=600
# Other sites allowed to call the API, comma-separated, e.g. https://your-portfolio.com
ALLOWED_ORIGINS=
# true writes question text (first 200 characters) to the server log
LOG_QUESTIONS=false
