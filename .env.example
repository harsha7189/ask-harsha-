# Copy this file to .env and fill in your key from https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Model: claude-sonnet-5-5 (default), claude-haiku-5-5 (cheapest), claude-opus-5-5 (strongest)
ASK_HARSHA_MODEL=claude-sonnet-5-5

# ---- Web server only ----
# Stop answering for the day after this much estimated spend, in US dollars
DAILY_BUDGET_USD=2
# Prices per million tokens; match them to the model above
PRICE_IN_PER_MTOK=2
PRICE_OUT_PER_MTOK=10
# Questions allowed per visitor in each window (seconds)
RATE_LIMIT_PER_WINDOW=12
RATE_WINDOW_SECONDS=600
# Other sites allowed to call the API, comma-separated, e.g. https://your-portfolio.com
ALLOWED_ORIGINS=
# true writes question text (first 200 characters) to the server log
LOG_QUESTIONS=false

# ---- General assistant ----
# Web search for current information ($10 per 1,000 searches)
WEB_SEARCH=true
PRICE_PER_SEARCH=0.01
# Passcode that unlocks owner mode (teaching the assistant). Leave empty to disable.
OWNER_PASSCODE=
# Where memory lives. Without these, notes go to knowledge/notes.local.json on this computer.
GITHUB_TOKEN=
NOTES_REPO=harsha7189/ask-harsha-
NOTES_BRANCH=notes
ASSISTANT_TIMEZONE=America/Chicago

# Assist mode (speech help): fast model and its own per-visitor limit
# ASSIST_MODEL=claude-haiku-5-5
# ASSIST_RATE_LIMIT_PER_WINDOW=60

# Ask the real Harsha: inbox encryption key (optional; defaults to one derived from OWNER_PASSCODE).
# Set a long random value if you might change the passcode later.
# INBOX_KEY=
